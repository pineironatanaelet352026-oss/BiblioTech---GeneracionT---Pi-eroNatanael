          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Respuesta de renovación evaluada según RN6', function () {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Devoluciones y Sanciones (RN4, RN5, RN11, HU4)",
      "item": [
        {
          "name": "POST /api/prestamos/:id/devolver (Devolución en mostrador)",
          "request": {
            "method": "POST",
