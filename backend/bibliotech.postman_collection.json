{
  "info": {
    "name": "BiblioTech API — Colección Oficial de Endpoints",
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "description": "Colección completa de pruebas para todos los endpoints de BiblioTech. Incluye variables de entorno, autenticación JWT automática y assertions de reglas de negocio (RN1 a RN11).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "tokenAdmin",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAlumno",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Healthcheck",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respuesta contiene status ok', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Autenticación y Usuarios",
      "item": [
        {
          "name": "POST /api/auth/login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Admin exitoso (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "    pm.collectionVariables.set('tokenAdmin', json.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bibliotech.edu\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "POST /api/auth/login (Alumno)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Alumno exitoso (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.collectionVariables.set('tokenAlumno', json.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan.perez@alumnos.edu\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "GET /api/auth/perfil (Protegido)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAlumno}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/perfil",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "perfil"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Perfil obtenido correctamente (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.email).to.eql('juan.perez@alumnos.edu');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Catálogo y Recursos (RN1, HU1)",
      "item": [
        {
          "name": "GET /api/recursos (Listado con disponibilidad)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/recursos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recursos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Catálogo obtenido con éxito (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.data[0]).to.have.property('ejemplares_disponibles');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/recursos con filtro buscar y solo_disponibles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/recursos?buscar=Fisica&solo_disponibles=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recursos"],
              "query": [
                { "key": "buscar", "value": "Fisica" },
                { "key": "solo_disponibles", "value": "true" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Filtros aplicados correctamente (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/recursos/:id (Detalle y ejemplares físicos)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/recursos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recursos", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Detalle obtenido con ejemplares (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('ejemplares');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Préstamos y Renovaciones (RN2, RN3, RN6, HU2, HU3)",
      "item": [
        {
          "name": "GET /api/prestamos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prestamos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Préstamos listados correctamente (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/prestamos (Registro presencial)",
          "request": {
