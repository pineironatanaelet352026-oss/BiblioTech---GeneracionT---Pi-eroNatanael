# Configuración del Servidor Backend (BiblioTech)
PORT=3000
NODE_ENV=development

# Cadena de conexión a PostgreSQL en Neon (Ejemplo ficticio - Reemplazar en .env local)
# Formato: postgresql://[usuario]:[password]@[host-neon].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://usuario_ejemplo:password_ficticio@ep-ejemplo.us-east-2.aws.neon.tech/bibliotech_db?sslmode=require

# Clave secreta para firma de Tokens JWT (Cadena aleatoria segura)
JWT_SECRET=clave_secreta_jwt_para_firmar_tokens_ejemplo_seguro_12345

# Origen permitido por CORS (URL del frontend en desarrollo o en Netlify)
FRONTEND_URL=http://localhost:5173
