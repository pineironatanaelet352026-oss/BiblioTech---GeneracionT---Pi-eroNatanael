            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": 3,\n  \"ejemplar_id\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prestamos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Préstamo registrado exitosamente (201)', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/prestamos/:id/renovar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAlumno}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos/1/renovar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prestamos", "1", "renovar"]
